# ============================================================
# Environment Variables Example
# Salin file ini menjadi .env atau .env.local kemudian sesuaikan nilainya
# ============================================================

# Database URL (PostgreSQL / Neon Serverless / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/sistem_kegiatan_db?schema=public"

# Secret Key untuk JSON Web Token (JWT) Autentikasi
JWT_SECRET="sistem-kegiatan-sekolah-secret-key-2026-very-long-and-secure"
